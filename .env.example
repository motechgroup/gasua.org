APP_NAME="Gusii All Stars Foundation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gasua.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL Database Configuration (Required for Shared Hosting)
# IMPORTANT: If your DB_PASSWORD contains special characters like #, $, or spaces, wrap it in double quotes:
# Example: DB_PASSWORD="9Kky9$bLl#TZK#.T"
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ncvjorqr_gasuabase
DB_USERNAME=ncvjorqr_admin
DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.gusiiallstars.org
MAIL_PORT=465
MAIL_USERNAME=info@gusiiallstars.org
MAIL_PASSWORD=""
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@gusiiallstars.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
